# Copy to .env and fill in. Nothing here belongs in version control.

# Where the SignSparK LMDBs live. Expected layout:
#   $DATA_ROOT/lmdb/{train,dev,test}/<Dataset>_reopt_<split>.lmdb
DATA_ROOT=./data

# Where back-translation checkpoints are downloaded to.
SIGNSPARK_BT_CKPT_DIR=./checkpoints

# Weights & Biases. Leave blank to train without experiment logging
# (also set `wandb: false` in the config).
WANDB_API_KEY=
WANDB_ENTITY=

# Override the HuggingFace repositories if you host your own copies.
# SIGNSPARK_BT_MODEL_REPO=LionelLow/SignSparK_BT
# SIGNSPARK_DATA_REPO=LionelLow/SignSparK_data
